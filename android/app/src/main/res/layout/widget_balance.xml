<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_hero_bg"
    android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saldo atual" android:textColor="#DDFFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/bal_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:text="R$ 0,00" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageView android:id="@+id/bal_add" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/widget_circle_light"
            android:padding="8dp" android:src="@drawable/ic_widget_plus" android:contentDescription="Novo lançamento" />
    </LinearLayout>
    <TextView android:id="@+id/bal_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="#CCFFFFFF" android:textSize="11sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑ Receitas" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/bal_income" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FF86EFAC" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓ Despesas" android:textColor="#CCFFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/bal_expense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFDA4AF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
